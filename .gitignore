# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.idea/
.vscode/
*.iml
*.swp
*~

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Terraform ---
infra/.terraform/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
!**/*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep .terraform.lock.hcl tracked (provider versions)

# --- Go / Gatus build ---
gatus/vendor/
gatus/gatus
gatus/gatus.exe
*.exe
*.test
*.out

# --- Node / frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.cache/

# --- Local / runtime data ---
*.db
*.db-shm
*.db-wal
*.log

# --- Docker ---
docker-compose.override.yml

# --- Local Gatus config (keep examples tracked) ---
gatus/config.yaml
gatus/config/config.yml
!gatus/.examples/**/config.yaml
!gatus/.examples/**/config/*.yaml

# --- Misc ---
*.zip
*.tar.gz
tmp/
temp/
